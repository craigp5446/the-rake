---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — The Rake" description="The page you requested doesn't exist. Find all reports at therake.co.">

<main class="not-found">
  <div class="not-found__inner">

    <header class="not-found__header">
      <p class="mono faint not-found__code">404</p>
      <h1 class="not-found__title">Page not found</h1>
      <p class="not-found__lead">The URL you requested doesn't exist. Here's where to look next.</p>
    </header>

    <nav class="not-found__nav" aria-label="Site navigation">
      <ul>
        <li><a href="/">All reports</a> — latest and previous issue scores</li>
        <li><a href="/about/">About</a> — who makes The Rake and the principles behind it</li>
        <li><a href="/methodology/">Methodology</a> — the seven-dimension scoring framework</li>
        <li><a href="/sitemap-index.xml">Sitemap</a> — full machine-readable URL list</li>
        <li><a href="/llms.txt">llms.txt</a> — agent-friendly site summary</li>
      </ul>
    </nav>

    <!--
    ## The Rake — 404

    The page you requested does not exist.

    ### Where to go next

    - [All reports](https://therake.co/) — latest and previous issue scores
    - [About](https://therake.co/about/) — who makes The Rake
    - [Methodology](https://therake.co/methodology/) — seven-dimension scoring framework
    - [Sitemap](https://therake.co/sitemap-index.xml) — full machine-readable URL list
    - [llms.txt](https://therake.co/llms.txt) — agent-friendly site summary
    -->

  </div>
</main>

</Base>

<style>
.not-found {
  padding: 0 var(--gutter);
}
.not-found__inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 6rem 0;
}
.not-found__code {
  font-size: 0.8125rem;
  letter-spacing: 0.12em;
  margin-bottom: 1rem;
}
.not-found__title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 400;
  line-height: 1.15;
  margin-bottom: 1rem;
}
.not-found__lead {
  font-size: 1.125rem;
  color: var(--text-muted);
  margin-bottom: 2.5rem;
}
.not-found__nav ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}
.not-found__nav li {
  font-size: 1rem;
  color: var(--text-muted);
}
.not-found__nav a {
  color: var(--text);
  text-decoration: underline;
  text-decoration-color: var(--border-strong);
  text-underline-offset: 2px;
  transition: text-decoration-color 0.15s;
}
.not-found__nav a:hover {
  text-decoration-color: var(--text);
}
</style>
