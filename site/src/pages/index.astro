---
import Base from '../layouts/Base.astro';
import FeaturedCard from '../components/FeaturedCard';
import ListCard from '../components/ListCard';
import reports from '../data/issues.json';

const formatDate = (iso: string) =>
  new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const labelGloss: Record<string, string> = {
  adversarial: 'designed to work against you',
  extractive:  'takes more than it delivers',
  compromised: 'genuine value, but not fully on your side',
  aligned:     'makes money when you get value',
  principled:  'actively prioritises your interests',
};

const brandfetchId = import.meta.env.BRANDFETCH_CLIENT_ID;
const logoSrc = (domain: string, logoPath?: string) =>
  logoPath ?? `https://cdn.brandfetch.io/${domain}/w/256/h/256?c=${brandfetchId}`;

const [featured, ...previous] = reports;
---

<Base title="The Rake — tech business model transparency">
  <main>

    <section class="hero">
      <div class="hero__inner">
        <img src="/therake.svg" alt="" class="hero__mark" aria-hidden="true" />
        <p class="hero__subhead">A transparency project, scoring tech companies on how well their interests align with yours.</p>
      </div>
    </section>

    <section class="cards-section">
      <div class="cards-inner">

        {featured && (
          <>
            <p class="section-label">Latest report</p>
            <div style="margin-bottom: 56px;">
              <FeaturedCard
                brandColor={featured.brandColor ?? '#9A9994'}
                logoSrc={logoSrc(featured.domain, featured.logoPath)}
                fallbackLetter={featured.company[0]}
                companyName={featured.company}
                date={formatDate(featured.published)}
                label={featured.label}
                score={featured.score}
                description={featured.summary ?? labelGloss[featured.label.toLowerCase()] ?? ''}
                href={`/issues/${featured.issue}`}
              />
            </div>
</>
        )}

        {previous.length > 0 && (
          <>
            <p class="section-label">Previous reports</p>
            <div class="list-wrap">
              {previous.map(r => (
                <ListCard
                  brandColor={r.brandColor ?? '#9A9994'}
                  logoSrc={logoSrc(r.domain, r.logoPath)}
                  fallbackLetter={r.company[0]}
                  companyName={r.company}
                  date={formatDate(r.published)}
                  label={r.label}
                  score={r.score}
                  description={r.summary ?? ''}
                  href={`/issues/${r.issue}`}
                />
              ))}
              <div style="border-bottom: 1px solid var(--border);" />
            </div>
          </>
        )}

      </div>
    </section>

  </main>
</Base>

<style>
.hero {
  padding: 5rem var(--gutter) 4rem;
  border-bottom: 1px solid var(--border);
}
.hero__inner {
  max-width: var(--max-w-wide);
  margin: 0 auto;
}
.hero__mark {
  display: none;
}
.hero__subhead {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2.25rem);
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.3;
  color: var(--text);
  max-width: 820px;
}

.cards-section {
  padding: 4rem var(--gutter) 6rem;
}
.cards-inner {
  max-width: var(--max-w-wide);
  margin: 0 auto;
}

.section-label {
  font-family: 'Space Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.15em;
  color: var(--text-faint);
  text-transform: uppercase;
  margin-bottom: 20px;
}

.list-wrap { max-width: var(--max-w-wide); }

@media (max-width: 600px) {
  .hero { padding: 3rem var(--gutter) 2.5rem; text-align: center; }
  .hero__inner { display: flex; flex-direction: column; align-items: center; }
  .hero__mark {
    display: block;
    height: 2rem;
    width: auto;
    margin-bottom: 1.5rem;
  }

  :global(.featured-card__inner) {
    flex-direction: column !important;
  }
  :global(.featured-card__brand) {
    width: 100% !important;
    min-width: unset !important;
    height: 160px;
  }
  :global(.featured-card__content) {
    padding: 20px 20px !important;
  }
}
</style>
