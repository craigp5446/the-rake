---
import Base from '../layouts/Base.astro';
import FeaturedCard from '../components/FeaturedCard';
import ListCard from '../components/ListCard';
import reports from '../data/issues.json';

const formatDate = (iso: string) =>
  new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const labelGloss: Record<string, string> = {
  adversarial: 'designed to work against you',
  extractive:  'takes more than it delivers',
  compromised: 'genuine value, but not fully on your side',
  aligned:     'makes money when you get value',
  principled:  'actively prioritises your interests',
};

const brandfetchId = import.meta.env.BRANDFETCH_CLIENT_ID;
const logoSrc = (domain: string) =>
  `https://cdn.brandfetch.io/${domain}/w/256/h/256?c=${brandfetchId}`;

const [featured, ...previous] = reports;
---

<Base title="The Rake — tech business model transparency">
  <main>

    <section class="hero">
      <div class="hero__inner">
        <p class="hero__subhead">Scoring tech companies and their apps on how they make money, how they're designed, and how those decisions affect the people who use them</p>
      </div>
    </section>

    <section class="cards-section">
      <div class="cards-inner">

        {featured && (
          <>
            <div style="margin-bottom: 20px;">
              <FeaturedCard
                brandColor={featured.brandColor ?? '#9A9994'}
                logoSrc={logoSrc(featured.domain)}
                fallbackLetter={featured.company[0]}
                companyName={featured.company}
                date={formatDate(featured.published)}
                label={featured.label}
                score={featured.score}
                description={labelGloss[featured.label.toLowerCase()] ?? ''}
                href={`/issues/${featured.issue}`}
              />
            </div>
            <p class="more-reports">More reports to come. To stay in the loop, <a href="https://buttondown.com/the-rake" target="_blank" rel="noopener">sign up here</a>.</p>
          </>
        )}

        {previous.length > 0 && (
          <>
            <p class="section-label">Previous reports</p>
            <div class="list-wrap">
              {previous.map(r => (
                <ListCard
                  brandColor={r.brandColor ?? '#9A9994'}
                  logoSrc={logoSrc(r.domain)}
                  fallbackLetter={r.company[0]}
                  companyName={r.company}
                  date={formatDate(r.published)}
                  label={r.label}
                  score={r.score}
                  description={labelGloss[r.label.toLowerCase()] ?? ''}
                  href={`/issues/${r.issue}`}
                />
              ))}
              <div style="border-bottom: 1px solid #d8d4ce;" />
            </div>
          </>
        )}

      </div>
    </section>

  </main>
</Base>

<style>
.hero {
  padding: 5rem var(--gutter) 4rem;
  border-bottom: 1px solid var(--border);
}
.hero__inner {
  max-width: var(--max-w-wide);
  margin: 0 auto;
}
.hero__subhead {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2.25rem);
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.3;
  color: var(--text);
  max-width: 820px;
}

.cards-section {
  padding: 4rem var(--gutter) 6rem;
}
.cards-inner {
  max-width: var(--max-w-wide);
  margin: 0 auto;
}

.section-label {
  font-family: 'Space Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.15em;
  color: #bbb;
  text-transform: uppercase;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.section-label::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #d8d4ce;
}

.list-wrap { max-width: var(--max-w-wide); }

.more-reports {
  font-family: 'DM Sans', sans-serif;
  font-size: 13px;
  color: #aaa;
  letter-spacing: 0.01em;
}
.more-reports a {
  color: #aaa;
  text-decoration: underline;
  text-underline-offset: 2px;
}
.more-reports a:hover { color: #777; }
</style>
