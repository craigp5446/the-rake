---
import Base from '../../layouts/Base.astro';
import type { GetStaticPaths } from 'astro';
import { readdir, readFile } from 'fs/promises';
import { join } from 'path';

export const getStaticPaths: GetStaticPaths = async () => {
  const dataDir = join(process.cwd(), 'src/data');
  const files = await readdir(dataDir);
  const issueFiles = files.filter(f => f !== 'issues.json' && f.endsWith('.json'));

  const paths = await Promise.all(issueFiles.map(async (file) => {
    const content = await readFile(join(dataDir, file), 'utf-8');
    const data = JSON.parse(content);
    return { params: { issue: String(data.issue) }, props: { report: data } };
  }));

  return paths;
};

const { report } = Astro.props;

type Finding = {
  id: string;
  type: 'negative' | 'positive' | 'trajectory';
  dimension: string | null;
  dimensionLabel: string | null;
  title: string;
  text: string;
  source: string;
  sourceUrl: string;
  sourceDate: string;
  sourceType: string;
};

type Dimension = {
  id: string;
  name: string;
  definition: string;
  score: number;
  scoreLabel: string;
  assessedCount: number;
  inferredCount: number;
  evidenceStrength: string;
  rationale: string;
  findings: string[];
};

type Source = {
  url: string;
  title: string;
  date: string;
  type: 'ASSESSED' | 'INFERRED';
};

const labelColours: Record<string, string> = {
  adversarial: '#E24B4A',
  extractive:  '#EF9F27',
  compromised: '#CECE30',
  aligned:     '#639922',
  principled:  '#1D9E75',
};

const labelGloss: Record<string, string> = {
  adversarial: 'This product is designed to work against you — it makes more money when you fail, stay confused, or can\'t leave.',
  extractive:  'This product takes more value from you than it delivers — engagement, data, or money are harvested in ways that don\'t serve your interests.',
  compromised: 'This product has genuine value but isn\'t fully on your side — trade-offs exist between what\'s good for you and what\'s good for the business.',
  aligned:     'This product makes money when you get value — its incentives and your interests point in the same direction.',
  principled:  'This product actively prioritises your interests, sometimes at cost to itself — the way it\'s built reflects values, not just incentives.',
};

const confidenceGloss: Record<string, { range: string; description: string }> = {
  high:   { range: '70%+ assessed',  description: 'Well-supported. Suitable for citation.' },
  medium: { range: '40–70% assessed', description: 'Reasonable but has meaningful inferred components. Treat as informed analysis.' },
  low:    { range: 'Below 40% assessed', description: 'Largely structural inference. Flagged for priority community verification.' },
};

const findingColours: Record<string, string> = {
  negative: '#E24B4A',
  positive: '#639922',
  trajectory: '#3B82F6',
};

const dimScoreGloss: Record<string, Record<number, string>> = {
  'revenue-clarity': {
    1: 'Misleading. Revenue streams are actively disguised. Hidden fees surface at checkout; data monetisation is structurally concealed.',
    2: 'Partial. Primary model is broadly known or findable, but secondary streams are not surfaced to users.',
    3: 'Clear. Revenue model stated plainly, including any secondary streams. A user can understand the full picture without research.',
  },
  'incentive-alignment': {
    1: 'Opposed. The business model structurally requires user failure or dependency.',
    2: 'Neutral. Revenue is not tied to user failure, but the company doesn\'t benefit from user success either.',
    3: 'Aligned. The company makes more money when users achieve outcomes.',
  },
  'captivity': {
    1: 'Deliberately trapped. Lock-in is engineered by design. Cancellation uses dark patterns; data is locked in proprietary formats.',
    2: 'Friction. Leaving is possible but inconvenient. Data export exists but is incomplete; cancellation is accessible but not prominent.',
    3: 'Portable. Data is exportable in usable formats; cancellation is self-serve and immediate; no meaningful penalty for leaving.',
  },
  'engagement-extraction': {
    1: 'Weaponised. The product is deliberately engineered to defeat the user\'s own ability to disengage.',
    2: 'Extractive. Engagement mechanics exist and are tied to revenue, but stop short of deliberately exploiting psychological vulnerabilities.',
    3: 'Value-driven. Engagement reflects genuine user value. The product is used when it is useful.',
  },
  'multi-sided-tension': {
    1: 'Users subordinated. The company\'s primary commercial relationship is with a third party; user interests are structurally subordinated.',
    2: 'Interests unresolved. The company serves more than one customer group; the track record when interests conflict is ambiguous.',
    3: 'Users defended. The company has a documented track record of siding with users when interests conflict, including at commercial cost.',
  },
  'algorithmic-accountability': {
    1: 'Unaccountable. Algorithmic systems actively surface or amplify harmful content and the company has chosen not to intervene.',
    2: 'Partial accountability. The company acknowledges responsibility but policies are inconsistently applied or incompletely disclosed.',
    3: 'Accountable. Clear and documented responsibility for what its systems surface; ranking signals disclosed; moderation consistently applied.',
  },
  'ownership-pressure': {
    1: 'Maximum pressure. PE-owned or public company under strong quarterly earnings pressure.',
    2: 'Moderate pressure. Public company (subscription or mixed model); mid-stage VC; some insulation from pure shareholder pressure.',
    3: 'Low pressure. Bootstrapped and profitable; co-op or employee-owned; nonprofit or mission-locked structure.',
  },
};

const labelColour = labelColours[report.label.toLowerCase()] ?? '#9A9994';
const spectrumBands = [
  { label: 'Adversarial', start: 0,  end: 20 },
  { label: 'Extractive',  start: 20, end: 40 },
  { label: 'Compromised', start: 40, end: 60 },
  { label: 'Aligned',     start: 60, end: 80 },
  { label: 'Principled',  start: 80, end: 100 },
];

const formatDate = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Pre-compute which findings link to each dimension
const findingMap: Record<string, Finding[]> = {};
for (const dim of report.dimensions as Dimension[]) {
  findingMap[dim.id] = (dim.findings as string[]).map((fid: string) =>
    (report.findings as Finding[]).find((f: Finding) => f.id === fid)
  ).filter(Boolean) as Finding[];
}

// Separate assessed and inferred sources for the sources section
const assessedSources = (report.sources as Source[]).filter(s => s.type === 'ASSESSED');
const inferredSources = (report.sources as Source[]).filter(s => s.type === 'INFERRED');
const flagCount = (report.findings as Finding[]).length;
const negativeCount = (report.findings as Finding[]).filter(f => f.type === 'negative').length;
const positiveCount = (report.findings as Finding[]).filter(f => f.type === 'positive').length;
const watchCount    = (report.findings as Finding[]).filter(f => f.type === 'trajectory').length;
---

<Base
  title={`Issue ${report.issue}: ${report.company} — The Rake`}
  description={report.summary}
>

<article class="report">

  {/* ── 1. Masthead ──────────────────────────────────────────── */}
  <header class="masthead">
    <div class="masthead__banner" style={`background: ${report.brandColor ?? '#9A9994'}`} aria-hidden="true">
      <img
        src={`https://cdn.brandfetch.io/${report.domain}/w/160/h/160?c=${import.meta.env.BRANDFETCH_CLIENT_ID}`}
        alt=""
        width="56"
        height="56"
        class="masthead__banner-img"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
      />
      <span class="masthead__banner-fallback">{report.company[0]}</span>
    </div>
    <div class="masthead__inner">

      <div class="masthead__title-row">
        <div class="masthead__logo" style={`background: ${report.brandColor ?? '#9A9994'}`}>
          <img
            src={`https://cdn.brandfetch.io/${report.domain}/w/160/h/160?c=${import.meta.env.BRANDFETCH_CLIENT_ID}`}
            alt={report.company}
            width="48"
            height="48"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
          />
          <span class="masthead__logo-fallback">{report.company[0]}</span>
        </div>
        <div class="masthead__title-col">
          <p class="masthead__date mono faint">{formatDate(report.published)}</p>
          <h1 class="masthead__company">{report.company}</h1>
          <div class="masthead__chips mono">
            <a href="https://github.com/craigphillips/the-rake/blob/main/methodology.md" target="_blank" rel="noopener" class="chip chip--link">Methodology v{report.methodologyVersion}<svg class="ext-icon" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2 10L10 2M10 2H5M10 2V7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <span class="chip-sep">·</span>
            <a href="#sources" class="chip chip--link">{report.sourceCount} sources <span class="sources-assessed">({report.assessedPct}% assessed)</span></a>
            <span class="chip-sep">·</span>
            <a href="#flags" class="chip chip--link">
              {flagCount} {flagCount === 1 ? 'flag' : 'flags'}
              <span class="flag-dots">
                {(report.findings as Finding[]).filter(f => f.type === 'negative').map(_ => <span class="flag-dot flag-dot--negative" />)}
                {(report.findings as Finding[]).filter(f => f.type === 'trajectory').map(_ => <span class="flag-dot flag-dot--trajectory" />)}
                {(report.findings as Finding[]).filter(f => f.type === 'positive').map(_ => <span class="flag-dot flag-dot--positive" />)}
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  {/* ── 2. Verdict block ─────────────────────────────────────── */}
  <section class="verdict" style={`--label-colour: ${labelColour}`}>
    <div class="verdict__inner">

      <div class="verdict__top">
        <div class="verdict__score-row">
          <div class="verdict__score-label">
            <span class="verdict__score">{report.score}<span class="verdict__total">/100</span></span>
            <span class="verdict__label has-tooltip">
              {report.label}
              <span class="verdict__tooltip" role="tooltip">{labelGloss[report.label.toLowerCase()]}</span>
            </span>
          </div>
          <div class="verdict__confidence mono has-tooltip">
            <span class="verdict__confidence-inner">
              {report.confidence} confidence
              <span class="verdict__tooltip verdict__tooltip--right" role="tooltip">{confidenceGloss[report.confidence.toLowerCase()]?.range} — {confidenceGloss[report.confidence.toLowerCase()]?.description}</span>
            </span>
          </div>
        </div>
      </div>

      <p class="verdict__summary">{report.summary}</p>

      {/* Spectrum bar */}
      <div class="spectrum" aria-label={`Score ${report.score} out of 100, ${report.label}`}>
        <div class="spectrum__track">
          {spectrumBands.map(band => (
            <div
              class="spectrum__band"
              style={`left: ${band.start}%; width: ${band.end - band.start}%; background: ${labelColours[band.label.toLowerCase()]};`}
              title={band.label}
            ></div>
          ))}
          <div
            class="spectrum__marker"
            style={`left: ${report.score}%`}
            title={`${report.score}/100 — ${report.label}`}
          ></div>
        </div>
        <div class="spectrum__labels mono">
          {spectrumBands.map(band => (
            <span
              class={`spectrum__label-item${band.label.toLowerCase() === report.label.toLowerCase() ? ' active' : ''}`}
              style={`left: ${band.start + (band.end - band.start)/2}%`}
            >
              {band.label}
              <span class="spectrum__label-tooltip" role="tooltip">{labelGloss[band.label.toLowerCase()]}</span>
            </span>
          ))}
        </div>
      </div>

      <div class="verdict__footer">
        <a href="#dimensions" class="verdict__scorecard-link mono">Scroll to scorecard<svg class="scroll-icon" viewBox="0 0 12 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 1v10M2 8l4 4 4-4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>

    </div>
  </section>

  <div class="report__body">
    <div class="report__body-inner">

      {/* ── 3. Narrative ───────────────────────────────────────── */}
      <section class="narrative-section">
        {report.narrative.map((para: string) => (
          <p>{para}</p>
        ))}
      </section>

      <hr class="divider" />

      {/* ── 4. Dimensions ──────────────────────────────────────── */}
      <section class="dimensions-section" id="dimensions">
        <h2 class="scorecard-heading">Scorecard</h2>
        <p class="section-heading muted">How this company scores across seven dimensions of user alignment, each rated 1–3.</p>

        <div class="score-grid">
          {(report.dimensions as Dimension[]).map((dim) => {
            const colour = dim.score === 3 ? 'var(--c-score-3)' : dim.score === 2 ? 'var(--c-score-2)' : 'var(--c-score-1)';
            return (
              <a href={`#dim-${dim.id}`} class="score-grid__row">
                <span class="score-grid__name mono">{dim.name}</span>
                <div class="score-grid__dots">
                  {[1,2,3].map(i => (
                    <span class={`score-grid__dot${i <= dim.score ? ' score-grid__dot--active' : ''}`} style={i <= dim.score ? `background: ${colour}` : ''} />
                  ))}
                </div>
              </a>
            );
          })}
        </div>

        {(report.dimensions as Dimension[]).map((dim, idx) => {
          const scoreColour = dim.score === 3 ? 'var(--c-score-3)' : dim.score === 2 ? 'var(--c-score-2)' : 'var(--c-score-1)';
          const relatedFindings = findingMap[dim.id] ?? [];
          const dimTotal = dim.assessedCount + dim.inferredCount;
          const dimPct = dimTotal > 0 ? Math.round((dim.assessedCount / dimTotal) * 100) : 0;
          const dimConfidence = dimPct >= 70 ? 'High' : dimPct >= 40 ? 'Medium' : 'Low';
          return (
            <>
              {idx === 0 && <hr class="divider" />}
              <div class="dimension" id={`dim-${dim.id}`}>
              <div class="dimension__header">
                <div class="dimension__title-row">
                  <h3 class="dimension__name" title={dim.definition}>
                    {dim.name}
                    <span class="dimension__def-tooltip" role="tooltip">{dim.definition}</span>
                  </h3>
                  <div class="dimension__score-block" style={`--score-colour: ${scoreColour}`}>
                    <span class="dimension__score-label mono has-tooltip" style={`color: ${scoreColour}`}>
                      {dim.scoreLabel}
                      <span class="verdict__tooltip verdict__tooltip--right" role="tooltip">{dimScoreGloss[dim.id]?.[dim.score]}</span>
                    </span>
                    <div class="dimension__score-dots">
                      {[1,2,3].map(i => (
                        <span class={`dim-dot${i <= dim.score ? ' dim-dot--active' : ''}`} />
                      ))}
                    </div>
                  </div>
                </div>
                <p class="dimension__meta mono faint">
                  {dimTotal} sources <span class="sources-assessed">({dimPct}% assessed)</span>
                  <span class="chip-sep">·</span>
                  {dimConfidence} confidence
                </p>
              </div>

              <p class="dimension__rationale">{dim.rationale}</p>

              {relatedFindings.length > 0 && (
                <div class="dimension__findings-pills">
                  {relatedFindings.map((f: Finding) => (
                    <a
                      href={`#finding-${f.id}`}
                      class="finding-pill"
                      data-type={f.type}
                      style={`--pill-colour: ${findingColours[f.type]}`}
                    >
                      <span class="finding-pill__icon" aria-hidden="true">
                        <svg width="9" height="9" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M2.5 1.5V12.5M2.5 1.5H10.5L8 5.5L10.5 9.5H2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      {f.title}
                    </a>
                  ))}
                </div>
              )}
            </div>
            </>
          );
        })}
      </section>

      <hr class="divider" />

      {/* ── 5. Flags ───────────────────────────────────────────── */}
      <section class="findings-section" id="flags">
        <h2 class="scorecard-heading">Flags</h2>
        <p class="section-heading muted">Specific documented incidents, commitments, or signals that affected how dimensions were scored.</p>

        <div class="findings-list">
          {([...(report.findings as Finding[])].sort((a, b) => {
            const parse = (d: string) => new Date(d.replace(/^Retrieved\s+/i, '')).getTime();
            const ta = parse(a.sourceDate); const tb = parse(b.sourceDate);
            if (isNaN(ta) && isNaN(tb)) return 0;
            if (isNaN(ta)) return 1;
            if (isNaN(tb)) return -1;
            return tb - ta;
          })).map((f: Finding) => (
            <div
              class="finding"
              id={`finding-${f.id}`}
              data-type={f.type}
            >
              <div class="finding__content">
                <div class="finding__header">
                  <div class="finding__type-row">
                    <div class="finding__icon" style={`background: ${findingColours[f.type]}`}>
                      <svg width="12" height="12" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M2.5 1.5V12.5M2.5 1.5H10.5L8 5.5L10.5 9.5H2.5" stroke="white" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                    <span class="finding__type-badge mono" style={`color: ${findingColours[f.type]}`}>
                      {f.type === 'negative' ? 'Negative' : f.type === 'positive' ? 'Positive' : 'Trajectory'}
                    </span>
                    {f.dimensionLabel && (
                      <>
                        <span class="finding__dim-sep mono faint">·</span>
                        <a href={`#dim-${f.dimension}`} class="finding__dim-tag mono faint">
                          {f.dimensionLabel}
                        </a>
                      </>
                    )}
                  </div>
                  <h3 class="finding__title">{f.title}</h3>
                </div>
                <p class="finding__text">{f.text}</p>
                <p class="finding__source mono faint">
                  <a href={f.sourceUrl} target="_blank" rel="noopener">{f.source}</a>
                  <span class="sep">·</span>
                  {f.sourceDate}
                  <span class="sep">·</span>
                  {f.sourceType.charAt(0).toUpperCase() + f.sourceType.slice(1).toLowerCase()}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <hr class="divider" />

      {/* ── 6. Sources ─────────────────────────────────────────── */}
      <section class="sources-section" id="sources">
        <h2 class="scorecard-heading">Sources</h2>
        <p class="section-heading muted">Evidence base for this report</p>
        <div class="sources-columns">
          <div class="sources-group">
            <p class="sources-group__label mono faint">Assessed ({assessedSources.length})</p>
            <ol class="sources-list">
              {assessedSources.map((s: Source) => (
                <li class="source-item">
                  <a href={s.url} target="_blank" rel="noopener">{s.title}</a>
                  <span class="source-item__date mono faint">{s.date}</span>
                </li>
              ))}
            </ol>
          </div>
          <div class="sources-group">
            <p class="sources-group__label mono faint">Inferred ({inferredSources.length})</p>
            <ol class="sources-list">
              {inferredSources.map((s: Source) => (
                <li class="source-item">
                  <a href={s.url} target="_blank" rel="noopener">{s.title}</a>
                  <span class="source-item__date mono faint">{s.date}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

    </div>
  </div>

</article>

</Base>

<style>
/* ── Masthead ──────────────────────────────────────────────── */
.masthead__banner {
  display: none;
}
.masthead {
  border-bottom: 1px solid var(--border);
  padding: 3.5rem var(--gutter) 2.5rem;
}
.masthead__inner {
  max-width: var(--max-w);
  margin: 0 auto;
}
.masthead__title-row {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
  margin-bottom: 1.25rem;
}
.masthead__title-col {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}
.masthead__date {
  font-size: 0.75rem;
  margin-bottom: 0.2rem;
}
.masthead__logo {
  width: 64px;
  height: 64px;
  flex-shrink: 0;
  border-radius: 12px;
  margin-top: 1.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.masthead__logo img {
  width: 48px; height: 48px;
  object-fit: contain;
}
.masthead__logo-fallback {
  display: none;
  font-family: var(--font-serif);
  font-size: 2rem;
  color: rgba(255,255,255,0.9);
}
.masthead__company {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 400;
  line-height: 1.1;
  margin-bottom: 0.35rem;
}
.masthead__chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.2rem 0;
  font-size: 0.75rem;
}
.chip { color: var(--text-faint); }
.chip--link {
  color: var(--text-muted);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 0.15s, color 0.15s;
  display: inline-flex;
  align-items: center;
  gap: 0.2rem;
}
.chip--link:hover {
  color: var(--text);
  border-bottom-color: var(--border-strong);
}
.ext-icon {
  width: 0.65rem;
  height: 0.65rem;
  flex-shrink: 0;
  opacity: 0.55;
  vertical-align: middle;
  position: relative;
  top: -0.05em;
}
.flag-dots {
  display: inline-flex;
  align-items: center;
  margin-left: 0.3rem;
}
.flag-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: 1.5px solid var(--bg);
  flex-shrink: 0;
  box-sizing: content-box;
}
.flag-dot + .flag-dot { margin-left: -3px; }
.flag-dot--negative { background: var(--c-negative); }
.flag-dot--positive { background: var(--c-positive); }
.flag-dot--trajectory { background: var(--c-watch); }
.sources-assessed {
  color: var(--text-faint);
  font-size: 0.7rem;
}
.chip-sep {
  color: var(--text-faint);
  opacity: 0.4;
  padding: 0 0.4rem;
}
.sep { opacity: 0.4; }

/* ── Verdict ───────────────────────────────────────────────── */
.verdict {
  padding: 2.5rem var(--gutter);
  border-bottom: 1px solid var(--border);
  background: color-mix(in srgb, var(--label-colour) 7%, var(--bg));
}
.verdict__inner {
  max-width: var(--max-w);
  margin: 0 auto;
}
.verdict__top {
  margin-bottom: 1.25rem;
}
.verdict__score-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
}
.verdict__score-label {
  display: flex;
  align-items: baseline;
  gap: 1.25rem;
}
.verdict__score {
  font-family: var(--font-serif);
  font-size: clamp(2.5rem, 6vw, 3.75rem);
  font-weight: 400;
  color: var(--text);
  line-height: 1;
}
.verdict__total {
  font-size: 1.25rem;
  color: var(--text-muted);
}
.verdict__label {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-style: normal;
  font-weight: 400;
  color: var(--text);
  cursor: default;
  position: relative;
  line-height: 1;
}
.verdict__confidence {
  font-size: 0.75rem;
  color: var(--text-faint);
  cursor: default;
}
.verdict__confidence-inner {
  position: relative;
}
.has-tooltip { position: relative; }
.verdict__tooltip {
  display: none;
  position: absolute;
