---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description = "Each issue scores one tech company on how its business model relates to the people who use it.", ogImage } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- OG -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {ogImage && <meta property="og:image" content={ogImage} />}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&family=Space+Mono:wght@400;700&display=swap');

    /* ── Design tokens ─────────────────────────────────────────── */
    :root {
      --c-adversarial:  #E24B4A;
      --c-extractive:   #EF9F27;
      --c-compromised:  #CECE30;
      --c-aligned:      #639922;
      --c-principled:   #1D9E75;

      --c-score-1: #E24B4A;
      --c-score-2: #EF9F27;
      --c-score-3: #639922;

      --c-negative: #E24B4A;
      --c-positive: #639922;
      --c-watch:    #3B82F6;

      --bg:         #FAFAF8;
      --bg-raised:  #F2F1EE;
      --bg-subtle:  #EBEBEA;
      --border:     #D6D5D0;
      --border-strong: #ABABAB;
      --text:       #111110;
      --text-muted: #4A4945;
      --text-faint: #9A9994;

      --font-serif:  'Cormorant Garamond', Georgia, serif;
      --font-body:   'Source Serif 4', Georgia, serif;
      --font-mono:   'IBM Plex Mono', 'Courier New', monospace;

      --max-w:      720px;
      --max-w-wide: 1100px;
      --gutter:     clamp(1.25rem, 5vw, 3rem);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg:         #111110;
        --bg-raised:  #1A1A18;
        --bg-subtle:  #222220;
        --border:     #2E2E2B;
        --border-strong: #444440;
        --text:       #F0EFEB;
        --text-muted: #9A9994;
        --text-faint: #5C5B57;
      }

      /* Invert black SVG logos so they're visible on dark backgrounds */
      .site-header__mark-center,
      .hero__mark {
        filter: invert(1);
      }

      /* Featured card dark mode overrides */
      .featured-card__inner {
        background: var(--bg-raised) !important;
        border-color: var(--border) !important;
      }
      .fc-name, .fc-score { color: var(--text) !important; }
      .fc-meta { color: var(--text-faint) !important; }
      .fc-desc { color: var(--text-muted) !important; }
      .fc-denom { color: var(--text-faint) !important; }
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 1.0625rem;
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }

    @media (max-width: 480px) {
      body { font-size: 1rem; }
    }
    img, svg { display: block; max-width: 100%; }
    a { color: inherit; }

    .mono { font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.01em; }
    .muted { color: var(--text-muted); }
    .faint { color: var(--text-faint); }

    .label--adversarial { color: var(--c-adversarial); }
    .label--extractive  { color: var(--c-extractive); }
    .label--compromised { color: var(--c-compromised); }
    .label--aligned     { color: var(--c-aligned); }
    .label--principled  { color: var(--c-principled); }

    .label-bg--adversarial { background: var(--c-adversarial); }
    .label-bg--extractive  { background: var(--c-extractive); }
    .label-bg--compromised { background: var(--c-compromised); }
    .label-bg--aligned     { background: var(--c-aligned); }
    .label-bg--principled  { background: var(--c-principled); }
  </style>
</head>
<body>

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__wordmark">THE RAKE</a>
    <img src="/therake.svg" alt="" class="site-header__mark-center" aria-hidden="true" />
    <nav class="site-header__nav" id="site-nav" aria-label="Main navigation">
      <a href="/about">About</a>
      <a href="/methodology">Methodology</a>
      <a href="https://buttondown.com/the-rake" target="_blank" rel="noopener" class="subscribe-btn">Subscribe</a>
    </nav>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('site-header__nav--open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  // Close on nav link click (for SPA-style navigation)
  nav?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      nav.classList.remove('site-header__nav--open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<slot />

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>The Rake. Analysis applied consistently, in public, and with all the receipts.</p>
  </div>
</footer>

<style>
.site-header {
  border-bottom: 1px solid var(--border);
  padding: 0 var(--gutter);
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg);
}
.site-header__inner {
  max-width: var(--max-w-wide);
  margin: 0 auto;
  height: 3.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}
.site-header__wordmark {
  font-family: var(--font-serif);
  font-size: 1.0625rem;
  font-style: italic;
  font-weight: 400;
  text-decoration: none;
  color: var(--text);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.site-header__mark-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  height: 1.25rem;
  width: auto;
  pointer-events: none;
}
.site-header__nav {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}
.site-header__nav a {
  font-family: var(--font-body);
  font-size: 0.875rem;
  font-weight: 400;
  text-decoration: none;
  color: var(--text-muted);
  transition: color 0.15s;
}
.site-header__nav a:hover { color: var(--text); }
.subscribe-btn {
  font-family: var(--font-body);
  font-size: 0.8125rem;
  font-weight: 600;
  text-decoration: none;
  color: var(--bg) !important;
  background: var(--text);
  padding: 0.4rem 0.9rem;
  border-radius: 2px;
  transition: opacity 0.15s;
}
.subscribe-btn:hover { opacity: 0.75; }

.site-footer {
  border-top: 1px solid var(--border);
  padding: 2.5rem var(--gutter);
  margin-top: 6rem;
}
.site-footer__inner {
  max-width: var(--max-w-wide);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}
.site-footer p {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-faint);
}
.site-footer a {
  color: var(--text-muted);
  text-decoration: none;
}
.site-footer a:hover { color: var(--text); }

/* ── Hamburger ───────────────────────────────── */
.nav-toggle {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 2rem;
  height: 2rem;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.25rem;
  flex-shrink: 0;
}
.nav-toggle__bar {
  display: block;
  width: 100%;
  height: 1.5px;
  background: var(--text);
  border-radius: 1px;
  transition: transform 0.2s, opacity 0.2s;
}

@media (max-width: 600px) {
  .site-header__mark-center { display: none; }

  .nav-toggle { display: flex; }

  .site-header__nav {
    display: none;
    position: absolute;
    top: 100%;
    left: calc(-1 * var(--gutter));
    right: calc(-1 * var(--gutter));
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
    padding: 0.5rem 0 1rem;
  }
  .site-header__nav.site-header__nav--open { display: flex; }
  .site-header__nav a {
    width: 100%;
    padding: 0.65rem var(--gutter);
    font-size: 1rem;
    text-align: right;
  }
  .site-header__nav .subscribe-btn {
    margin: 0.5rem var(--gutter) 0;
    width: auto;
    align-self: flex-end;
    text-align: center;
  }
}

/* ── Card hover ──────────────────────────────── */
.rake-featured-card {
  transition: box-shadow 0.2s ease, transform 0.2s ease;
  display: block;
}
.rake-featured-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 36px rgba(0,0,0,0.08);
}
.rake-list-card {
  transition: opacity 0.15s ease;
}
.rake-list-card:hover { opacity: 0.55; }
</style>
</body>
</html>
